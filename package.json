{
  "name": "tree-physics",
  "private": true,
  "type": "module",
  "scripts": {
    "build:treephysics": "node scripts/TreePhysics/build.mjs",
    "check:treephysics": "tsc --noEmit -p tsconfig.TreePhysics.json",
    "package:treephysics": "node scripts/TreePhysics/packaging/tree-physics-pack.mjs",
    "test:treephysics": "npm run check:treephysics && vitest run --config vitest.config.ts && npm run verify:release-build",
    "verify:release-build": "node scripts/TreePhysics/verification/release-build.mjs"
  },
  "dependencies": {
    "@minecraft/common": "1.3.0",
    "@minecraft/server": "2.8.0",
    "@minecraft/server-ui": "2.1.0",
    "@minecraft/vanilla-data": "1.26.44",
    "cannon-es": "0.20.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "cheerio": "^1.1.2",
    "esbuild": "0.28.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
