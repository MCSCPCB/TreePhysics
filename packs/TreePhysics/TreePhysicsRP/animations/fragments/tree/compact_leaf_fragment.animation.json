{
  "format_version": "1.8.0",
  "animations": {
    "animation.treephysics.compact_leaf_fragment.transform": {
      "loop": true,
      "bones": {
        "root": {
          "scale": "v.pose_ready",
          "rotation": [
            "-q.body_x_rotation",
            "-q.body_y_rotation",
            0
          ]
        },
        "pitch": {
          "rotation": [
            "v.pitch",
            0,
            0
          ]
        },
        "roll": {
          "rotation": [
            0,
            0,
            "-v.roll"
          ]
        },
        "yaw": {
          "rotation": [
            0,
            "-v.yaw",
            0
          ]
        },
        "fragment_offset": {
          "position": [
            "(math.mod(q.property('treephysics:origin_xz'), 2048) - 1024) * 16",
            "(q.property('treephysics:origin_y') - 1024) * 16",
            "-(math.floor(q.property('treephysics:origin_xz') / 2048) - 1024) * 16"
          ]
        }
      }
    }
  }
}
