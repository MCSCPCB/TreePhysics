{
  "format_version": "1.20.30",
  "minecraft:client_entity": {
    "description": {
      "identifier": "treephysics:leaf_fragment",
      "materials": {
        "leaves": "alpha_block_color",
        "foliage_colormap": "foliage_colormap_multiply"
      },
      "textures": {
        "leaf_oak": "textures/blocks/leaves_oak",
        "leaf_spruce": "textures/blocks/leaves_spruce",
        "leaf_birch": "textures/blocks/leaves_birch",
        "leaf_jungle": "textures/blocks/leaves_jungle",
        "leaf_acacia": "textures/blocks/leaves_acacia",
        "leaf_dark_oak": "textures/blocks/leaves_big_oak",
        "leaf_cherry": "textures/blocks/cherry_leaves",
        "leaf_mangrove": "textures/blocks/mangrove_leaves",
        "leaf_pale_oak": "textures/blocks/pale_oak_leaves",
        "leaf_azalea": "textures/blocks/azalea_leaves",
        "leaf_flowering_azalea": "textures/blocks/azalea_leaves_flowers",
        "colormap_foliage": "textures/colormap/foliage",
        "colormap_swamp_foliage": "textures/colormap/swamp_foliage",
        "colormap_mangrove_swamp_foliage": "textures/colormap/mangrove_swamp_foliage",
        "colormap_birch": "textures/colormap/birch",
        "colormap_evergreen": "textures/colormap/evergreen",
        "colormap_foliage_fixed": "textures/colormap/foliage_fixed"
      },
      "geometry": {
        "leaves": "geometry.treephysics.leaf_fragment.leaves",
        "foliage_colormap_x": "geometry.treephysics.leaf_fragment.foliage_colormap_x",
        "foliage_colormap_z": "geometry.treephysics.leaf_fragment.foliage_colormap_z"
      },
      "render_controllers": [
        "controller.render.treephysics.leaf_fragment.leaves",
        {
          "controller.render.treephysics.leaf_fragment.foliage_colormap": "v.tint_kind >= 1"
        }
      ],
      "animations": {
        "transform": "animation.treephysics.leaf_fragment.transform"
      },
      "scripts": {
        "initialize": [
          "v.pose_initialized = 0;",
          "v.pose_ready = 0;"
        ],
        "animate": [
          "transform"
        ],
        "pre_animation": [
          "v.pose_ready = q.property('treephysics:family') >= 16;",
          "v.pitch = v.pose_ready ? (v.pose_initialized ? math.lerprotate(v.pitch, q.property('treephysics:pitch'), q.delta_time/0.05) : q.property('treephysics:pitch')) : 0;",
          "v.yaw = v.pose_ready ? (v.pose_initialized ? math.lerprotate(v.yaw, q.property('treephysics:yaw'), q.delta_time/0.05) : q.property('treephysics:yaw')) : 0;",
          "v.roll = v.pose_ready ? (v.pose_initialized ? math.lerprotate(v.roll, q.property('treephysics:roll'), q.delta_time/0.05) : q.property('treephysics:roll')) : 0;",
          "v.pose_initialized = v.pose_ready;",
          "v.tint = q.property('treephysics:tint');",
          "v.tint_0 = math.mod(math.floor(v.tint / 1), 32);",
          "v.tint_1 = math.mod(math.floor(v.tint / 32), 32);",
          "v.tint_2 = math.mod(math.floor(v.tint / 1024), 32);",
          "v.tint_3 = math.mod(math.floor(v.tint / 32768), 32);",
          "v.tint_state = math.floor(v.tint / 1048576);",
          "v.tint_uniform = v.tint_state == 7;",
          "v.tint_axis_z = v.tint_state >= 8;",
          "v.tint_kind = v.tint_uniform ? 1 : math.mod(v.tint_state, 8);",
          "v.tint_pixel_u = math.mod(v.tint, 256);",
          "v.tint_pixel_v = math.mod(math.floor(v.tint / 256), 256);",
          "v.l0 = q.property('treephysics:l0');",
          "v.l1 = q.property('treephysics:l1');",
          "v.l2 = q.property('treephysics:l2');",
          "v.l3 = q.property('treephysics:l3');",
          "v.l4 = q.property('treephysics:l4');",
          "v.l5 = q.property('treephysics:l5');",
          "v.l6 = q.property('treephysics:l6');",
          "v.l7 = q.property('treephysics:l7');",
          "v.l8 = q.property('treephysics:l8');",
          "v.l9 = q.property('treephysics:l9');",
          "v.l10 = q.property('treephysics:l10');"
        ]
      }
    }
  }
}
