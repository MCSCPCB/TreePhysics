{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "treephysics:tree_splash",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/white_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.water_count"
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": "v.activation_flag ?? 0",
				"expiration_expression": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["Math.cos(v.particle_random_1*360)*v.water_radius_x+(v.particle_random_2-0.5)*v.water_scatter_x", "v.particle_random_4*0.4", "Math.sin(v.particle_random_1*360)*v.water_radius_z+(v.particle_random_3-0.5)*v.water_scatter_z"],
				"direction": ["Math.cos(v.particle_random_1*360)*4*v.water_strength+(v.particle_random_2-0.5)*6", "v.water_up_speed", "Math.sin(v.particle_random_1*360)*4*v.water_strength+(v.particle_random_3-0.5)*6"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.25+Math.floor(v.particle_random_3*7)/20"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "v.particle_random_4*360"
			},
			"minecraft:particle_initial_speed": "Math.sqrt(Math.pow(Math.cos(v.particle_random_1*360)*4*v.water_strength+(v.particle_random_2-0.5)*6,2)+Math.pow(v.water_up_speed,2)+Math.pow(Math.sin(v.particle_random_1*360)*4*v.water_strength+(v.particle_random_3-0.5)*6,2))",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -15.696, 0],
				"linear_drag_coefficient": 0.404
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.3+v.particle_random_2*0.9", "0.3+v.particle_random_2*0.9"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 12,
						"max_frame": 12,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.3,
				"collision_radius": 0.05
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, "(1-v.particle_age/v.particle_lifetime)*(0.5+v.particle_random_1*0.5)"]
			}
		}
	}
}
