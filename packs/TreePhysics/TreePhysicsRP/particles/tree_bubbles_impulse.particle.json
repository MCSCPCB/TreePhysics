{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "treephysics:tree_bubbles_impulse",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "v.water_rate*v.water_area",
				"max_particles": "Math.floor(Math.min(400,v.water_max_particles*v.water_area))"
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": "v.activation_flag ?? 0",
				"expiration_expression": "!(v.activation_flag ?? 1) || v.emitter_age >= 0.1"
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, "-0.25*v.water_depth_scale", 0],
				"half_dimensions": ["0.5*v.water_scale_x", "0.25*v.water_depth_scale", "0.5*v.water_scale_z"],
				"surface_only": true,
				"direction": ["Math.random(-0.25,0.25)", -1, "Math.random(-0.25,0.25)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.min(10,Math.random(3,6)*v.water_explosion_progress)"
			},
			"minecraft:particle_expire_if_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": "v.water_speed_base+v.particle_random_4*v.water_speed_spread",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["-1+v.particle_random_2*2", "v.particle_random_1*2", "-1+v.particle_random_3*2"],
				"linear_drag_coefficient": "Math.random(4,6)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["Math.hermite_blend(Math.clamp(v.particle_age/(v.particle_lifetime*0.01),0,1)-Math.clamp((v.particle_age-(v.particle_lifetime*0.8))/(v.particle_lifetime*0.2),0,1))*(7/16/4)", "Math.hermite_blend(Math.clamp(v.particle_age/(v.particle_lifetime*0.01),0,1)-Math.clamp((v.particle_age-(v.particle_lifetime*0.8))/(v.particle_lifetime*0.2),0,1))*(7/16/4)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [0, 16],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [0.6, 0.6, 0.6, 1]
			}
		}
	}
}
