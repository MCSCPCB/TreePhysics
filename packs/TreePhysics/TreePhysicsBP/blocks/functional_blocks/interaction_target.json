{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "treephysics:interaction_target",
      "states": {
        "treephysics:water_depth": {
          "values": {
            "min": 0,
            "max": 15
          }
        },
        "treephysics:water_kind": [0, 1, 2]
      }
    },
    "components": {
      "minecraft:collision_box": false,
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      },
      "minecraft:destructible_by_explosion": false,
      "minecraft:destructible_by_mining": false,
      "minecraft:geometry": {
        "identifier": "geometry.treephysics.interaction_target",
        "bone_visibility": {
          "block": false
        }
      },
      "minecraft:light_dampening": 0,
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true,
            "liquid_type": "water",
            "on_liquid_touches": "no_reaction",
            "use_liquid_clipping": true
          }
        ]
      },
      "minecraft:material_instances": {
        "*": {
          "render_method": "blend",
          "texture": "structure_void"
        }
      },
      "minecraft:selection_box": true,
      "minecraft:tick": {
        "interval_range": [20, 20],
        "looping": true
      },
      "treephysics:interaction_target_cleanup": {}
    }
  }
}
